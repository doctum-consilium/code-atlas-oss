[Unit]
Description=code-atlas — web front (127.0.0.1:4173)
After=code-atlas-api.service

# Template: scripts/install.sh replaces @ROOT@ and @NODE@ with this machine's paths.
[Service]
Type=simple
WorkingDirectory=@ROOT@/web
# Serves the build (strict CSP header). Rebuild: npm run build.
Environment=PATH=@NODE_DIR@:/usr/bin:/bin
ExecStart=@NODE@ node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4173 --strictPort
Restart=on-failure
RestartSec=10
Nice=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
