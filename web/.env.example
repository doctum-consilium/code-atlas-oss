# Public values only (no secret); copy to .env.local to change them.
# Base URL of the code-atlas API.
VITE_API_URL=http://127.0.0.1:8790
# Extra origins allowed in the CSP connect-src, space separated. In OIDC mode the issuer is only
# known at runtime (GET /v1/public-config), so its origin must be listed here, for instance:
# VITE_CSP_EXTRA_CONNECT=https://sso.example.org
VITE_CSP_EXTRA_CONNECT=
